# Copy to .env.local (gitignored) and fill in real values. The app runs fine in guest mode
# with none of these set - analytics stays off, billing stays in "Bientot disponible" mode.

# PostHog (EU Cloud) - product analytics, consent-gated (see CookieConsent / consentStore).
# Public key (phc_...), safe to expose client-side.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# RevenueCat Web (sandbox test store key while in development). Public key, safe client-side.
VITE_REVENUECAT_TEST_STORE_KEY=

# Sentry - crash reporting (erreurs uniquement, pas de PII ni replay).
# DSN public, safe client-side. Non defini = monitoring off, zero impact.
VITE_SENTRY_DSN=

# Flips on real web checkout via RevenueCat/Stripe. Leave unset (or any value other than
# "true") until Stripe is connected in the RevenueCat dashboard - the paywall then shows
# "Bientot disponible" instead of a broken purchase flow.
VITE_BILLING_ENABLED=false

# --- Server-side / CI only, never exposed to the client bundle ---
# RevenueCat secret key (server-to-server), PostHog personal API key (dashboard automation).
# Never prefix these with VITE_ - Vite would otherwise inline them into the public bundle.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
# Consumed only by scripts/posthog-setup.mjs (npm run posthog:setup) to create/update the
# PostHog dashboard + insights from docs/posthog/insights.json. Scopes needed: insight:read,
# insight:write, dashboard:read, dashboard:write, restricted to project 238190. Revoke after
# use - see docs/OBSERVABILITE.md.
POSTHOG_PERSONAL_API_KEY=
