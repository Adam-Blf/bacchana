{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/gardes/*.mjs",
    "scripts/outils/*.mjs",
    "scripts/outils/*.js",
    "scripts/animations/*.mjs",
    "scripts/visual-contrast/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,js}"
  ],
  "ignoreDependencies": [
    "axe-core"
  ],
  "ignoreExportsUsedInFile": true
}
